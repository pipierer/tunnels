# ---- BenTunnel — Variables d'environnement (Render) ----
# Copiez ce fichier en .env (local) ou renseignez chaque variable dans
# l'interface Render → Environment. NE JAMAIS committer le vrai .env.

# --- Base de données MySQL (Alwaysdata) ---
# Format : mysql+asyncmy://USER:PASSWORD@HOST:PORT/DBNAME?charset=utf8mb4
# Sur Alwaysdata : HOST = mysql-COMPTE.alwaysdata.net, PORT = 3306
DATABASE_URL=mysql+asyncmy://bentunnel_user:CHANGE_ME@mysql-moncompte.alwaysdata.net:3306/moncompte_bentunnel?charset=utf8mb4

# --- Sécurité ---
# Clé HMAC utilisée pour signer les JWT tunnel. 64 caractères hex aléatoires.
# Générer avec : python -c "import secrets; print(secrets.token_hex(32))"
BEN_TUNNEL_SECRET=CHANGE_ME_GENERATE_64_HEX_CHARS_RANDOM

# --- Compte administrateur bootstrap ---
# Au premier démarrage, si aucun user avec cet email n'existe, il est créé
# avec le mot de passe ci-dessous et is_admin=1. Changez le mot de passe
# depuis le dashboard après la première connexion.
ADMIN_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=ChangeMeStrongPassword123!
ADMIN_BOOTSTRAP_FIRST_NAME=Admin

# --- URL publique ---
# L'URL Render de votre service. Sert à construire les URLs /tunnels/{username}
# et l'URL WSS que le client Python utilise.
PUBLIC_BASE_URL=https://bentunnel.onrender.com

# --- Limites (optionnel, valeurs par défaut indiquées) ---
# Taille max d'une requête HTTP forwardée (octets).
MAX_REQUEST_BYTES=5242880
# Taille max d'une réponse HTTP forwardée (octets).
MAX_RESPONSE_BYTES=5242880
# Timeout d'une requête HTTP forwardée (secondes).
HTTP_TIMEOUT_SECONDS=30
# Nombre max de connexions WS simultanées sur le serveur.
MAX_WS_CONNECTIONS=200

# --- Sessions ---
# Durée de vie d'une session web en jours.
SESSION_TTL_DAYS=7
# Durée de vie d'un token tunnel JWT en secondes (5 min recommandé).
TUNNEL_TOKEN_TTL_SECONDS=300

# --- Noms des cookies (optionnel, ne pas changer en prod) ---
SESSION_COOKIE_NAME=bentunnel_session
CSRF_COOKIE_NAME=bentunnel_csrf

# --- Keep-alive (optionnel) ---
# URL à pinger par le cron externe pour empêcher la mise en veille.
# Par défaut = PUBLIC_BASE_URL + /health
KEEPALIVE_URL=https://bentunnel.onrender.com/health
